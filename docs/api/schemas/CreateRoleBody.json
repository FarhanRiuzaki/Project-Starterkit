{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CreateRoleBody",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 40
    },
    "permissions": {
      "default": [],
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]+\\.[a-z][a-z0-9_]{0,31}$"
      }
    }
  },
  "required": [
    "name"
  ]
}
