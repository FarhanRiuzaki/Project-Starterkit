{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BulkUserBody",
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "activate",
        "deactivate",
        "delete",
        "assignRole"
      ]
    },
    "ids": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "role": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    }
  },
  "required": [
    "action",
    "ids"
  ]
}
