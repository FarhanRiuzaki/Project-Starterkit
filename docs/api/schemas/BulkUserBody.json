{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BulkUserBody",
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "activate",
        "deactivate",
        "delete",
        "assignRole"
      ]
    },
    "ids": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "filter": {
      "type": "object",
      "properties": {
        "q": {
          "type": "string",
          "maxLength": 200
        },
        "role": {
          "type": "string",
          "maxLength": 64
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "inactive"
          ]
        }
      },
      "additionalProperties": false
    },
    "role": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    }
  },
  "required": [
    "action"
  ]
}
