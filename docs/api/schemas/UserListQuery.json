{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UserListQuery",
  "type": "object",
  "properties": {
    "page": {
      "default": 1,
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "pageSize": {
      "default": 15,
      "enum": [
        15,
        25,
        50,
        100
      ],
      "type": "number"
    },
    "q": {
      "type": "string",
      "maxLength": 200
    },
    "sort": {
      "type": "string",
      "enum": [
        "name",
        "-name",
        "email",
        "-email",
        "lastLoginAt",
        "-lastLoginAt",
        "createdAt",
        "-createdAt"
      ]
    },
    "role": {
      "anyOf": [
        {
          "type": "string",
          "const": ""
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        }
      ]
    },
    "status": {
      "anyOf": [
        {
          "type": "string",
          "const": ""
        },
        {
          "type": "string",
          "enum": [
            "active",
            "inactive"
          ]
        },
        {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "active",
              "inactive"
            ]
          }
        }
      ]
    }
  }
}
