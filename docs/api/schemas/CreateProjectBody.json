{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CreateProjectBody",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "description": {
      "default": "",
      "type": "string",
      "maxLength": 500
    },
    "status": {
      "default": "active",
      "type": "string",
      "enum": [
        "active",
        "archived"
      ]
    }
  },
  "required": [
    "name"
  ]
}
