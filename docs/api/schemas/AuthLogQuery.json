{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AuthLogQuery",
  "type": "object",
  "properties": {
    "page": {
      "default": 1,
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "pageSize": {
      "default": 15,
      "enum": [
        15,
        25,
        50,
        100
      ],
      "type": "number"
    },
    "sort": {
      "type": "string",
      "enum": [
        "at",
        "-at",
        "login",
        "-login",
        "event",
        "-event"
      ]
    },
    "from": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "to": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "user": {
      "type": "string",
      "maxLength": 64
    },
    "format": {
      "default": "json",
      "type": "string",
      "enum": [
        "json",
        "csv"
      ]
    },
    "event": {
      "type": "string",
      "enum": [
        "login_success",
        "login_failed",
        "logout",
        "2fa_success",
        "2fa_failed"
      ]
    },
    "method": {
      "type": "string",
      "enum": [
        "password",
        "ldap",
        "google",
        "apple"
      ]
    }
  }
}
