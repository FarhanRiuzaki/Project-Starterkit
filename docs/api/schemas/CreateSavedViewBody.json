{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CreateSavedViewBody",
  "type": "object",
  "properties": {
    "path": {
      "type": "string",
      "pattern": "^\\/[a-z][a-z/-]{0,39}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "query": {
      "type": "string",
      "maxLength": 300,
      "pattern": "^[^#\\s]*$"
    }
  },
  "required": [
    "path",
    "name",
    "query"
  ],
  "additionalProperties": false
}
