{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AuthContextDto",
  "type": "object",
  "properties": {
    "user": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "username": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "avatarUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "isActive": {
          "type": "boolean"
        },
        "isLdap": {
          "type": "boolean"
        },
        "twoFactorEnabled": {
          "type": "boolean"
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "connected": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "google",
              "apple"
            ]
          }
        },
        "lastLoginAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "createdAt": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "username",
        "email",
        "avatarUrl",
        "isActive",
        "isLdap",
        "twoFactorEnabled",
        "roles",
        "connected",
        "lastLoginAt",
        "createdAt"
      ],
      "additionalProperties": false
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "user",
    "permissions"
  ],
  "additionalProperties": false
}
