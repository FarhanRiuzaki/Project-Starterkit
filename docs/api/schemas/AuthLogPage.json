{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AuthLogPage",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "at": {
            "type": "string"
          },
          "userId": {
            "type": [
              "string",
              "null"
            ]
          },
          "login": {
            "type": "string"
          },
          "event": {
            "type": "string",
            "enum": [
              "login_success",
              "password_ok",
              "login_failed",
              "logout",
              "2fa_success",
              "2fa_failed",
              "password_reset"
            ]
          },
          "method": {
            "type": "string",
            "enum": [
              "password",
              "ldap",
              "google",
              "apple"
            ]
          },
          "ip": {
            "type": "string"
          },
          "device": {
            "type": "string"
          },
          "location": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "at",
          "userId",
          "login",
          "event",
          "method",
          "ip",
          "device",
          "location"
        ],
        "additionalProperties": false
      }
    },
    "total": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "page": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "pageSize": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "totalCapped": {
      "type": "boolean"
    }
  },
  "required": [
    "items",
    "total",
    "page",
    "pageSize"
  ],
  "additionalProperties": false
}
