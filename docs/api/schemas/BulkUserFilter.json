{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BulkUserFilter",
  "type": "object",
  "properties": {
    "q": {
      "type": "string",
      "maxLength": 200
    },
    "role": {
      "anyOf": [
        {
          "type": "string",
          "const": ""
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        }
      ]
    },
    "status": {
      "anyOf": [
        {
          "type": "string",
          "const": ""
        },
        {
          "type": "string",
          "enum": [
            "active",
            "inactive"
          ]
        },
        {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "active",
              "inactive"
            ]
          }
        }
      ]
    }
  },
  "additionalProperties": false
}
