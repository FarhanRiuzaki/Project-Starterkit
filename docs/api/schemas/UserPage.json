          "permissions": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "user.view",
                "user.create",
                "user.edit",
                "user.delete",
                "role.view",
                "role.create",
                "role.edit",
                "role.delete",
                "permission.view",
                "permission.create",
                "audit.view"
              ]
            }
          }
        },
        "required": [
          "id",
          "name",
          "username",
          "email",
          "avatarUrl",
          "isActive",
          "isLdap",
          "twoFactorEnabled",
          "roles",
          "connected",
          "lastLoginAt",
          "createdAt",
          "permissions"
        ],
        "additionalProperties": false
