{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SessionListQuery",
  "type": "object",
  "properties": {
    "page": {
      "default": 1,
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "pageSize": {
      "default": 15,
      "enum": [
        15,
        25,
        50,
        100
      ],
      "type": "number"
    },
    "sort": {
      "type": "string",
      "enum": [
        "lastSeenAt",
        "-lastSeenAt",
        "device",
        "-device"
      ]
    }
  }
}
