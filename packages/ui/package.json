{
  "name": "@starterkit/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": ["*.css"],
  "exports": {
    "./ui/icons": "./src/ui/icons.ts",
    "./ui/toast": "./src/ui/toast.ts",
    "./ui/*": "./src/ui/*.tsx",
    "./motion": "./src/motion/index.ts",
    "./ds": "./src/ds/index.ts",
    "./charts": "./src/charts/index.ts",
    "./lib/*": "./src/lib/*.ts",
    "./styles/*": "./src/styles/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:changed": "vitest run --changed --passWithNoTests"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "4.3.5",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.4.0",
    "motion": "14.0.0",
    "next-themes": "0.4.6",
    "qrcode-generator": "2.0.4",
    "radix-ui": "1.6.7",
    "recharts": "3.8.0",
    "sonner": "2.0.8"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "happy-dom": "20.14.5",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "peerDependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
