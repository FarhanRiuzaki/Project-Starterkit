# docker-compose.yml takes its values from .env.compose (gitignored, never commit it), passed to every command:
#   docker compose --env-file .env.compose up -d --build
# cp .env.compose.example .env.compose, then replace every change-me and fill every empty secret. Each service gets
# only the keys docker-compose.yml lists for it. Random values: openssl rand -hex 32 (hex needs no URL-encoding in
# the database URLs and holds no `$`, which compose would read as a variable).

# Two database roles, two URLs:
# - POSTGRES_PASSWORD: the superuser `postgres`, owner of the schema; only the migrate service uses it
#   (MIGRATION_DATABASE_URL).
# - APP_DB_PASSWORD: the role `starterkit_app` (scripts/compose-app-role.sh creates it when the volume is new) with
#   SELECT/INSERT/UPDATE/DELETE only; the API connects as it (DATABASE_URL).
# Each URL repeats its password.
POSTGRES_PASSWORD=change-me-owner
APP_DB_PASSWORD=change-me-app
DATABASE_URL=postgresql://starterkit_app:change-me-app@postgres:5432/starterkit
MIGRATION_DATABASE_URL=postgresql://postgres:change-me-owner@postgres:5432/starterkit

# Shared by the API and the web: at least 32 characters.
INTERNAL_API_TOKEN=
# API: base64 of exactly 32 random bytes (openssl rand -base64 32).
DATA_ENCRYPTION_KEY=
# Web: seals the session cookie, at least 32 characters.
SESSION_SECRET=
# Web: the public origin users open (absolute og:image and icon URLs), e.g. https://app.example.com.
APP_URL=http://localhost:3001

# Production sends mail through SMTP over TLS: smtps://…:465 (TLS from the first byte) or smtp://…:587?requireTLS=true
# (STARTTLS, refused when the server doesn't offer it); plain smtp:// is refused in production.
MAIL_TRANSPORT=smtp
SMTP_URL=smtp://user:change-me@smtp.example.com:587?requireTLS=true
MAIL_FROM=Starterkit <noreply@example.com>

# Web: true once the site is served over HTTPS; TRUSTED_PROXY=true behind a proxy that sets X-Forwarded-*.
# COOKIE_SECURE=false
# TRUSTED_PROXY=false

# Optional API sign-in methods (LDAP_*, GOOGLE_*, APPLE_*): same keys as apps/api/.env.example.

# First Superadmin for `docker compose --env-file .env.compose run --rm migrate bun run db:seed` (password 12 to 128
# characters). Only the migrate service gets these.
SEED_SUPERADMIN_NAME=
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_USERNAME=
SEED_SUPERADMIN_PASSWORD=
