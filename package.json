{
  "name": "starterkit",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run --filter @starterkit/web dev",
    "build": "bun run --filter @starterkit/web build",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "eslint --max-warnings 0 .",
    "test": "bun run --filter '*' test",
    "test:changed": "bun run --filter '*' test:changed",
    "check": "bun run typecheck && bun run lint && bun run test"
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "typescript": "6.0.3"
  }
}
