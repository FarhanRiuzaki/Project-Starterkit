{
  "name": "starterkit",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run --filter '@starterkit/web' --filter '@starterkit/api' dev",
    "setup": "bun scripts/setup.ts",
    "db:generate": "bun run --filter @starterkit/api db:generate",
    "db:migrate": "bun run --filter @starterkit/api db:migrate",
    "db:seed": "bun run --filter @starterkit/api db:seed",
    "db:seed:demo": "bun run --filter @starterkit/api db:seed:demo",
    "db:reset": "bun run --filter @starterkit/api db:reset",
    "build": "bun run --filter @starterkit/web build",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "eslint --max-warnings 0 .",
    "test": "bun run --filter '*' test",
    "test:changed": "bun run --filter '*' test:changed",
    "check": "bun run typecheck && bun run lint && bun run test",
    "e2e": "bun run --filter @starterkit/web e2e",
    "budget": "node apps/web/scripts/bundle-budget.mjs",
    "api:schemas": "bun apps/web/scripts/emit-api-schemas.ts"
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "typescript": "6.0.3"
  }
}
