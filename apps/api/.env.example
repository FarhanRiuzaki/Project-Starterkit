# API settings (apps/api/src/kernel/config.ts). `bun run setup` writes apps/api/.env with random secrets; never commit it.

# Required
DATABASE_URL=postgresql://app_user:change-me@localhost:5432/app
# Shared with apps/web (.env.local): at least 32 characters.
INTERNAL_API_TOKEN=
# base64 of exactly 32 random bytes (encrypts TOTP secrets): openssl rand -base64 32
DATA_ENCRYPTION_KEY=

# Optional (defaults shown)
# NODE_ENV=development
# API_HOST=127.0.0.1
# API_PORT=4000
# Schema owner for migrations; defaults to DATABASE_URL.
# MIGRATION_DATABASE_URL=
# DB_POOL_MAX=10
# SESSION_TTL_HOURS=12
# SESSION_IDLE_MINUTES=120
# The web app's address: links in emails and the OAuth redirect URIs (required in production).
# APP_URL=http://localhost:3000
# log | smtp (production requires smtp, with SMTP_URL and MAIL_FROM)
# MAIL_TRANSPORT=log
# Production refuses SMTP without TLS: smtps://…:465 is TLS from the first byte; smtp://…:587?requireTLS=true upgrades
# with STARTTLS and fails when the server doesn't offer it (plain smtp:// would send in clear text then).
# SMTP_URL=smtp://user:password@smtp.example.com:587?requireTLS=true
# MAIL_FROM=SunnyGo <noreply@example.com>
# AUDIT_RETENTION_DAYS=365
# LOG_LEVEL=info
# Mock Google/Apple and directory sign-in for development and tests; refused in production.
# OAUTH_MOCK=false
# LDAP_MOCK=false
# Directory sign-in (users marked LDAP): search LDAP_BASE_DN with LDAP_USER_FILTER as LDAP_BIND_DN, then bind as the
# entry found. Production needs ldaps:// or LDAP_STARTTLS=true.
# LDAP_URL=ldaps://directory.example.com:636
# LDAP_BIND_DN=cn=app,dc=example,dc=com
# LDAP_BIND_PASSWORD=
# LDAP_BASE_DN=dc=example,dc=com
# LDAP_USER_FILTER=(uid={username})
# LDAP_STARTTLS=false
# Google and Apple sign-in: a provider is on when all of its keys are set. Register the redirect URI
# APP_URL/api/auth/oauth/google/callback (or .../apple/callback) with the provider.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=com.example.app.signin
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# The Sign in with Apple key (.p8), PKCS#8 PEM; write line breaks as \n on one line.
# APPLE_PRIVATE_KEY=

# Superadmin that `bun run db:seed` creates; empty = none.
SEED_SUPERADMIN_NAME=
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_USERNAME=
SEED_SUPERADMIN_PASSWORD=
