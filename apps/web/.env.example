# Web settings (apps/web/src/lib/server/config.ts). `bun run setup` writes apps/web/.env.local; never commit it.

# Shared with apps/api/.env: at least 32 characters.
INTERNAL_API_TOKEN=
# The API, server-side only (never NEXT_PUBLIC_*). Required in production; development defaults to this value.
API_BASE_URL=http://127.0.0.1:4000
# Public origin of this site (absolute og:image and icon URLs), server-side only (never NEXT_PUBLIC_*). Required in
# production; development defaults to this value.
APP_URL=http://localhost:3000
# Seals the session cookie: at least 32 characters. Required in production; development picks one per process.
SESSION_SECRET=

# Optional (defaults shown)
# SESSION_TTL_HOURS=12
# COOKIE_SECURE=false
# TRUSTED_PROXY=false
# LOG_LEVEL=info
# Fake Google/Apple authorize step, with OAUTH_MOCK=true in apps/api/.env too; development and E2E only.
# OAUTH_MOCK=false
